{
  "name": "os-cast",
  "version": "1.0.0",
  "description": "Next-generation universal screen & audio mirroring for Fire TV, Smart TVs, Chromecast, and Web",
  "author": "OS Cast Contributors",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && electron electron/main.cjs\"",
    "electron:build": "tsc -b && vite build && electron-builder",
    "electron:build:mac": "tsc -b && vite build && electron-builder --mac",
    "electron:build:win": "tsc -b && vite build && electron-builder --win",
    "electron:build:linux": "tsc -b && vite build && electron-builder --linux"
  },
  "dependencies": {
    "lucide-react": "^1.65.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.oscast.app",
    "productName": "OS Cast Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "OS Cast Pro requiere acceso a la pantalla para transmitirla a tu televisor Fire TV.",
        "NSAudioCaptureUsageDescription": "OS Cast Pro requiere acceso al audio del sistema para transmitir el sonido a tu televisor Fire TV.",
        "NSMicrophoneUsageDescription": "OS Cast Pro requiere acceso al audio para transmitir el sonido a tu televisor."
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video"
    }
  }
}
